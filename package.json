{
  "name": "barnes-maze-scorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based scoring tool for Barnes maze behavioural videos.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:eval": "vitest run test/eval.test.ts test/tracking-accuracy.test.ts",
    "score-samples": "node scripts/run-score.mjs",
    "fixtures": "./scripts/make-fixtures.sh"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mp4box": "0.5.2",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  }
}